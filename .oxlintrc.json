{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    // neverthrow's `_unsafeUnwrap` / `_unsafeUnwrapErr`
    "eslint/no-underscore-dangle": "off",
    // Flags immutable updates inside neverthrow's `Result#map` too; tsc already checks return types
    "oxc/no-map-spread": "off",
    // Reports exhaustive switches over literal unions; tsc already checks return types
    "typescript/consistent-return": "off",
    "eslint/eqeqeq": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
      "rules": {
        // Helpers are kept next to the describe block that uses them
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
