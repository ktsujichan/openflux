{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "cloudflare.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    // Global EmscriptenWasm namespace used by the @jsquash/jxl codec typings
    "node_modules/@jsquash/jxl/emscripten-types.d.ts"
  ]
}
